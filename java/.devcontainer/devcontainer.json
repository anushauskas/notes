// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/images/tree/main/src/java
{
	"name": "Java 25 LTS",
	"image": "mcr.microsoft.com/devcontainers/java:25",

	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "none",
			"installMaven": true
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack"
			]
		}
	}

	// "postCreateCommand": "cd HelloWorld && mvn -q compile"
}
